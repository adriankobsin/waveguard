        "type": "bacnet_ip",
        "host": "192.168.1.60",
        "port": 47808,
        "deviceInstance": 1001
      },
      "bacnetMap": {
        "currentTemperature": { "objectType": "analogInput", "instance": 1, "property": "presentValue" },
        "targetTemperature": { "objectType": "analogValue", "instance": 1, "property": "presentValue" },
        "powerState": { "objectType": "binaryValue", "instance": 1, "property": "presentValue" },
        "mode": { "objectType": "multiStateValue", "instance": 1, "property": "presentValue", "mapping": { 0: "off", 1: "cool", 2: "heat", 3: "auto" } },
        "fanSpeed": { "objectType": "multiStateValue", "instance": 2, "property": "presentValue", "mapping": { 0: "auto", 1: "low", 2: "medium", 3: "high" } },
        "alarmCode": { "objectType": "analogValue", "instance": 10, "property": "presentValue" }
      }
    },
    {
      "id": "bridge",
      "name": "Bridge",
      "deck": "Upper Deck",
      "room": "Wheelhouse",
      "manufacturer": "heinen_hopman",
